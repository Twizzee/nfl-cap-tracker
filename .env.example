# Supabase -> Connect -> Transaction pooler connection string
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres

# Random string, at least 16 chars. Vercel sends it to cron endpoints automatically.
CRON_SECRET=replace-with-a-long-random-secret

# Set true only if you want visitors to be able to trigger the expensive full-league sync button.
ALLOW_PUBLIC_SYNC=false

# Local development only
AUTO_SYNC=false
SYNC_MINUTES=30
