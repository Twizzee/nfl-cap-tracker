{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/team/:slug", "destination": "/seo.html" },
    { "source": "/player/:team/:slug", "destination": "/seo.html" },
    { "source": "/games", "destination": "/seo.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 12 * * *"
    }
  ]
}
